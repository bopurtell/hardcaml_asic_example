# Generated by the example launcher with machine-specific executable and state paths.
# Ignore only its three companions, including the legacy root copies.
/.workbench/hardcaml-workbench-asic.sexp
/.workbench/hardcaml-workbench-preparation.sexp
/.workbench/hardcaml-workbench-simulation.sexp
/hardcaml-workbench-asic.sexp
/hardcaml-workbench-preparation.sexp
