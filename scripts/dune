(rule
 (alias preparation-test)
 (deps check_prepare.py
       (env_var HARDCAML_ASIC_PREPARATION_PROVIDER)
       (env_var HARDCAML_ASIC_PREPARATION_SOURCE_ROOT)
       (source_tree ../asics/program_memory/project) ../asics/program_memory/README.md
       (source_tree ../ip/controlled_fifo/rtl)
       (source_tree ../asics/fifo_demo/project) (source_tree ../asics/fifo_demo/rtl)
       ../dune-project ../asic-dependency.json ../README.md
       ../asics/fifo_demo/cli/dune ../asics/fifo_demo/cli/project.ml)
 (action
  (run python3 -B %{dep:check_prepare.py}
   --memory %{exe:../asics/program_memory/project/memory_cli.exe}
   --fifo %{exe:../asics/fifo_demo/cli/project.exe}
   --provider %{env:HARDCAML_ASIC_PREPARATION_PROVIDER=hardcaml-asic-flow}
   --source-root %{env:HARDCAML_ASIC_PREPARATION_SOURCE_ROOT=.})))

(rule
 (alias runtest)
 (deps asic_dependency.py test_asic_dependency.py)
  (action (run python3 %{dep:test_asic_dependency.py})))

(rule
 (alias ownership-layout-test)
 (deps test_ownership_layout.py test_workbench_dev.py workbench_dev.py workbench_git.py
       (source_tree ../integration/workbench) (source_tree ../tooling_acceptance)
       (source_tree ../ip/controlled_fifo) (source_tree ../asics)
       ../dune-project ../asic-dependency.json ../README.md ../bootstrap.sh)
 (action (run python3 -B %{dep:test_ownership_layout.py})))

(rule
 (alias runtest)
 (deps check_project_cli.py)
 (action (run python3 %{dep:check_project_cli.py} %{exe:../asics/fifo_demo/cli/project.exe})))

(rule
 (alias runtest)
 (deps ../bootstrap.sh test_bootstrap.py)
 (action (run python3 %{dep:test_bootstrap.py})))

(rule
 (alias runtest)
 (deps test_project_routing.py (env_var HARDCAML_ASIC_TEST_PROVIDER)
       (env_var HARDCAML_ASIC_TEST_EVIDENCE) (source_tree ../ip/controlled_fifo/rtl)
       (source_tree ../asics/fifo_demo/project) (source_tree ../asics/fifo_demo/rtl)
       ../dune-project ../asic-dependency.json ../README.md
       ../asics/fifo_demo/cli/dune ../asics/fifo_demo/cli/project.ml)
 (action (run python3 %{dep:test_project_routing.py} %{exe:../asics/fifo_demo/cli/project.exe}
               %{exe:../asics/fifo_demo/verif/bundle/export_trace.exe} ..)))

(rule
 (alias headless-test)
  (deps headless_flow.py test_headless_flow.py test_project_routing.py
        (env_var HARDCAML_ASIC_TEST_PROVIDER) (env_var HARDCAML_ASIC_ENGINE_FIXTURES)
        (source_tree ../ip/controlled_fifo/rtl) (source_tree ../asics/fifo_demo/project)
        (source_tree ../asics/fifo_demo/rtl)
       ../dune-project ../asic-dependency.json ../README.md
       ../asics/fifo_demo/cli/dune ../asics/fifo_demo/cli/project.ml)
 (action (run python3 -B %{dep:test_headless_flow.py} %{exe:../asics/fifo_demo/cli/project.exe}
              %{exe:../asics/fifo_demo/verif/bundle/export_trace.exe} ..)))
